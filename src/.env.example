# =============================================================================
# .env.example — Safe template committed to version control
# =============================================================================
# Copy this file to .env and fill in your own values.
#   cp .env.example .env
# =============================================================================

# --- Gemini API Keys (comma-separated, no spaces) ---
# Obtain from: https://aistudio.google.com/app/apikey
# You can provide multiple keys for automatic key-rotation and quota fallback.
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2

# --- Tesseract OCR Path (leave blank to auto-detect on Windows) ---
# If Tesseract is installed in a non-standard location, set the full path here.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
